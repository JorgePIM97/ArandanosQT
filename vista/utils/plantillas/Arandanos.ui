    min-width: 120px;
}

/* Estilo del botón desplegable (conserva la flecha nativa) */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;  /* Ancho suficiente para la flecha */
}

/* Estilo del menú desplegable (popup) */
QComboBox QAbstractItemView {
    background-color: rgb(255, 255, 255);
    color: black;
    border: 2px solid rgb(176, 151, 198);
    font-family: &quot;Segoe UI Semibold&quot;, &quot;Arial&quot;, sans-serif;
    font-size: 24px;
    font-weight: 660;
    padding: 8px 15px;
    outline: 0;  /* Elimina el borde de enfoque punteado */
}



</string>
